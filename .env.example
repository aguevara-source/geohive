# Copiar a .env y cambiar TODOS los valores. El archivo .env no se sube al repositorio.

# URL pública con la que se accede a la plataforma (sin "/" final)
#   local: http://localhost:8088      producción: https://agygeohive.com
PUBLIC_URL=http://localhost:8088
WEB_PORT=8088

# Clave para proteger códigos y sesiones. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esta_clave_larga_y_aleatoria

# true en producción (HTTPS). false solo para pruebas locales por http.
COOKIE_SECURE=false

# ---------- Base de datos principal (PostgreSQL 14+ con PostGIS) ----------
# Una sola base; cada servicio crea sus tablas en su propio esquema (auth, visor, geocodificador, geodata).
# Si la base corre en el mismo equipo que Docker: PG_HOST=host.docker.internal
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=cambia_clave
PG_DATABASE=geohive

# ---------- Correo saliente (código de acceso) ----------
# Pruebas locales: Mailpit captura los correos en http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SEGURIDAD=ninguna
SMTP_USUARIO=
SMTP_PASSWORD=
CORREO_REMITENTE=AG-Y GEOHIVE <no-responder@agygeohive.com>

# Producción, ejemplos:
#   Hosting/cPanel:  SMTP_HOST=mail.agygeohive.com  SMTP_PORT=465  SMTP_SEGURIDAD=ssl
#   Gmail/Workspace: SMTP_HOST=smtp.gmail.com       SMTP_PORT=587  SMTP_SEGURIDAD=starttls (contraseña de aplicación)
#   Amazon SES / Brevo / SendGrid: datos SMTP del proveedor


# ---------- Portal ----------
# true: solo presentación (oculta "Ingresar" y el acceso a las aplicaciones).
# Cambiar a false cuando la plataforma completa (base de datos + apps) esté desplegada.
SOLO_PRESENTACION=true

# ---------- Formulario de contacto del portal ----------
# Correo que recibe los mensajes del formulario. Se envían con el SMTP configurado arriba.
# Con Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SEGURIDAD=starttls  SMTP_USUARIO=tu_correo@gmail.com
#   SMTP_PASSWORD='contraseña'  (entre comillas simples si tiene el símbolo $)
CONTACTO_DESTINO=tu_correo@gmail.com
